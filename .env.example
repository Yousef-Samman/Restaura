# Copy to .env (never commit .env). All values are optional.
ANTHROPIC_API_KEY=
RESTAURA_MODEL=claude-opus-5-5
STORE_NAME=Demo Store
DATABASE_URL=sqlite:///./restaura.db
# Email for approved supplier orders. Without SMTP_HOST, emails are logged in the app instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Demo only: send every supplier email to this one inbox.
DEMO_SUPPLIER_EMAIL=
