# Copy to .env (never commit .env). All values are optional.
ANTHROPIC_API_KEY=
# Use this name instead where ANTHROPIC_API_KEY is reserved (e.g. Claude Code cloud environments)
RESTAURA_ANTHROPIC_API_KEY=
RESTAURA_MODEL=claude-opus-5-5
STORE_NAME=Demo Store
# Passwords for the demo accounts, created on first start
MANAGER_PASSWORD=
CASHIER_PASSWORD=
# Set to 1 when served over HTTPS
SECURE_COOKIES=0
DATABASE_URL=sqlite:///./restaura.db
# Email for approved supplier orders. Without SMTP_HOST, emails are logged in the app instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Demo only: send every supplier email to this one inbox.
DEMO_SUPPLIER_EMAIL=
# Send every WhatsApp order to this number in a demo (international format, digits only)
DEMO_SUPPLIER_WHATSAPP=
